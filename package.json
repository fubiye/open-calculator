{
  "name": "open-calculator",
  "version": "0.1.0",
  "private": true,
  "description": "开放、可扩展、AI 原生的计算器：类 Excel 网格 + Rust 后端 + 桌面端",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @open-calculator/web dev",
    "dev:server": "cargo run -p open-calculator-server",
    "dev:desktop": "pnpm --filter @open-calculator/desktop dev",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "pnpm --filter @open-calculator/web build",
    "build:server": "cargo build --release -p open-calculator-server",
    "build:desktop": "pnpm --filter @open-calculator/desktop build",
    "lint": "pnpm -r --if-present lint && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "test": "pnpm -r --if-present test && cargo test --workspace"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1"
  }
}
