# .env.example
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。

# ---------- Rust 后端 ----------
OPEN_CALCULATOR_HOST=127.0.0.1
OPEN_CALCULATOR_PORT=8787
RUST_LOG=info

# ---------- 前端（可选） ----------
# 留空时：浏览器开发期走 Vite proxy（同源 /api）；Tauri 桌面端自动直连 127.0.0.1:8787。
# 只有在自定义后端地址时才需要设置：
# VITE_API_BASE_URL=http://127.0.0.1:8787

# ---------- AI Provider（v0.3 规划，当前未读取） ----------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
