{
  "name": "open-calculator-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Open Calculator 前端（React + Univer）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @open-calculator/web dev",
    "dev:web": "pnpm --filter @open-calculator/web dev",
    "dev:desktop": "pnpm --filter @open-calculator/desktop dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @open-calculator/web build",
    "build:desktop": "pnpm --filter @open-calculator/desktop build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
